#!/bin/sh
# Point Claude Desktop / Claude Code / Codex at this file, not at node.
#
# Claude Desktop spawns MCP servers with a near-empty environment, so nothing
# here relies on PATH. The binaries were resolved once at install by
# bin/ps-mcp-resolve and recorded in etc/binaries.conf; this script reads that
# file, grants the sandbox exactly those install prefixes, and execs the server
# under Seatbelt (kernel-level disk isolation) plus node's permission model.
#
# POSIX sh only: /bin/sh is bash 3.2 in POSIX mode on macOS, never zsh.
set -eu

APP_DIR=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
PROFILE="$APP_DIR/etc/ps-mcp.sb"
CONF="$APP_DIR/etc/binaries.conf"

conf_get() { [ -f "$CONF" ] && sed -n "s|^$1=||p" "$CONF" | head -1 || true; }

# Work root: the one subtree tools may read and write.
WORK_REQUESTED=${PS_MCP_WORK:-$HOME}
if [ ! -d "$WORK_REQUESTED" ]; then
  echo "ps-mcp: work root does not exist: $WORK_REQUESTED" >&2
  exit 1
fi
WORK=$(cd -- "$WORK_REQUESTED" && pwd -P)
TMP=$(cd -- "${TMPDIR:-/tmp}" && pwd -P)

NODE_BIN=${PS_MCP_NODE:-$(conf_get node)}
if [ -z "$NODE_BIN" ] || [ ! -x "$NODE_BIN" ]; then
  echo "ps-mcp: node not resolved. Run bin/ps-mcp-resolve (needs your PATH)," >&2
  echo "        or set PS_MCP_NODE to an absolute path." >&2
  exit 1
fi
NODE_DIR=$(cd -- "$(dirname -- "$NODE_BIN")/.." && pwd -P)

export PS_MCP_WORK="$WORK"
# Which ~/.aws profile the S3 tools authenticate as. Claude Desktop passes no
# environment, so the SDK would otherwise fall back to [default] implicitly.
export AWS_PROFILE="${PS_MCP_AWS_PROFILE:-default}"
# gws encrypts stored credentials; keep the key in a file rather than the macOS
# Keychain, which the sandbox deliberately cannot reach.
export GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND=file

# Give ps-mcp its OWN gws config directory, separate from the one your shell, a
# gws skill or another MCP server uses. gws DELETES credentials it cannot
# decrypt, so a single call from elsewhere under a different keyring backend
# destroys this login. Two callers sharing one directory while disagreeing about
# the backend is not survivable; isolating removes the whole class.
export GOOGLE_WORKSPACE_CLI_CONFIG_DIR="${PS_MCP_GWS_DIR:-$HOME/.config/ps-mcp/gws}"
mkdir -p "$GOOGLE_WORKSPACE_CLI_CONFIG_DIR"

# Record what gws does, so the next credential loss is evidence and not a guess.
export GOOGLE_WORKSPACE_CLI_LOG_FILE="$GOOGLE_WORKSPACE_CLI_CONFIG_DIR/logs"
mkdir -p "$GOOGLE_WORKSPACE_CLI_LOG_FILE"

# Seatbelt cannot loop, so install prefixes go into a fixed set of parameters.
# Unused slots must still be defined or the profile fails to compile; /var/empty
# is a real, empty, read-only directory, so an unused slot grants nothing.
PREFIXES=$([ -f "$CONF" ] && sed -n 's|^prefix=||p' "$CONF" || true)
P1=/var/empty; P2=/var/empty; P3=/var/empty; P4=/var/empty
i=0
for p in $PREFIXES; do
  i=$((i + 1))
  case $i in 1) P1=$p ;; 2) P2=$p ;; 3) P3=$p ;; 4) P4=$p ;;
    *) echo "ps-mcp: more than 4 install prefixes; ignoring $p" >&2 ;;
  esac
done

set -- /usr/bin/sandbox-exec -f "$PROFILE" \
  -D HOME="$HOME" \
  -D WORK="$WORK" \
  -D APP_DIR="$APP_DIR" \
  -D NODE_DIR="$NODE_DIR" \
  -D TMP="$TMP" \
  -D AWS_DIR="$HOME/.aws" \
  -D GWS_DIR="$GOOGLE_WORKSPACE_CLI_CONFIG_DIR" \
  -D GWS_SUPPORT_DIR="$HOME/Library/Application Support/gws" \
  -D HOME_LIBRARY="$HOME/Library" \
  -D TOOL_PREFIX_1="$P1" \
  -D TOOL_PREFIX_2="$P2" \
  -D TOOL_PREFIX_3="$P3" \
  -D TOOL_PREFIX_4="$P4" \
  "$NODE_BIN" \
    --permission \
    --allow-child-process \
    --allow-fs-read="$APP_DIR" \
    --allow-fs-read="$APP_DIR/*" \
    --allow-fs-read="$WORK/*" \
    --allow-fs-write="$WORK/*" \
    --allow-fs-write="$TMP/*" \
    --allow-fs-read="$HOME/.aws/*" \
    --allow-fs-read="$HOME/Library/Application Support/gws/*"

# node's permission model is inherited by node-based children, so every install
# prefix has to be readable by them too -- gws is itself a node script.
for p in $PREFIXES; do
  set -- "$@" --allow-fs-read="$p/*"
done

set -- "$@" "$APP_DIR/src/server.js"
exec "$@"
