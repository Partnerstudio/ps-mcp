#!/bin/sh
# Resolve every binary the manifest needs, once, in YOUR shell, and record the
# absolute results in etc/binaries.conf.
#
# This is the only place a PATH lookup happens. It runs at install time, under a
# human, with the operator's own PATH -- never at tool-call time with input from
# a model. Everything downstream uses the absolute paths recorded here, so the
# manifest never has to guess where a tool might be installed.
set -eu

APP_DIR=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
OUT="$APP_DIR/etc/binaries.conf"

# Arguments may pin a binary explicitly as name=/absolute/path. A packaged
# install knows exactly where it put things, so it pins them and no PATH search
# happens at all; a dev machine passes nothing and everything is looked up.
NEEDED=""
for arg in "$@"; do
  case "$arg" in
    *=*) eval "PIN_${arg%%=*}='${arg#*=}'"; NEEDED="$NEEDED ${arg%%=*}" ;;
    *)   NEEDED="$NEEDED $arg" ;;
  esac
done
[ -n "$NEEDED" ] || NEEDED="node ffprobe ffmpeg gws"

printf '# Generated by bin/ps-mcp-resolve on %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$OUT"
printf '# name=absolute path, plus prefix=... lines the sandbox grants. Do not edit;\n' >> "$OUT"
printf '# re-run bin/ps-mcp-resolve after installing or upgrading a tool.\n' >> "$OUT"

missing=''
prefixes=''
for name in $NEEDED; do
  # An explicit pin wins; then PS_MCP_<NAME>; then the operator's PATH.
  eval "path=\${PIN_$name:-}"
  [ -n "$path" ] || eval "path=\${PS_MCP_$(printf '%s' "$name" | tr '[:lower:]-' '[:upper:]_'):-}"
  [ -n "$path" ] || path=$(command -v "$name" 2>/dev/null || true)
  if [ -z "$path" ] || [ ! -x "$path" ]; then
    missing="$missing $name"
    printf '  %-10s NOT FOUND on PATH\n' "$name" >&2
    continue
  fi
  # Two different needs, and conflating them is a bug:
  #
  #   - To EXECUTE, record the stable path. /opt/homebrew/bin/ffprobe is a symlink
  #     that Homebrew repoints on upgrade; its target
  #     /opt/homebrew/Cellar/ffmpeg/9.0.1_1/bin/ffprobe is deleted by that upgrade.
  #     Recording the resolved target pins us to a version that will disappear.
  #   - To SANDBOX, grant the real location too, because a symlink may point
  #     outside its own prefix -- /usr/local/bin/gws lands in ~/.nvm/...
  #
  # So: the link path is what we run, and both prefixes are granted.
  real=$(readlink -f -- "$path" 2>/dev/null || echo "$path")
  printf '%s=%s\n' "$name" "$path" >> "$OUT"
  if [ "$real" != "$path" ]; then
    printf '  %-10s %s -> %s\n' "$name" "$path" "$real" >&2
  else
    printf '  %-10s %s\n' "$name" "$path" >&2
  fi

  for p in "$path" "$real"; do
    dir=$(dirname -- "$p")
    case "$dir" in
      */bin) prefix=$(cd -- "$dir/.." && pwd -P) ;;
      *)     prefix=$dir ;;
    esac
    case " $prefixes " in *" $prefix "*) ;; *) prefixes="$prefixes $prefix" ;; esac
  done
done

# Collapse prefixes contained in another: granting /opt/homebrew already covers
# /opt/homebrew/Cellar/ffmpeg/9.0.2. This keeps the list short (Seatbelt cannot
# loop, so the launcher has a fixed number of slots) and, more importantly, drops
# version-pinned prefixes that a later upgrade would invalidate.
for p in $prefixes; do
  contained=no
  for q in $prefixes; do
    [ "$p" = "$q" ] && continue
    case "$p" in "$q"/*) contained=yes; break ;; esac
  done
  [ "$contained" = yes ] || printf 'prefix=%s\n' "$p" >> "$OUT"
done

if [ -n "$missing" ]; then
  printf '\nps-mcp: not found:%s\n' "$missing" >&2
  printf 'Tools needing them will be skipped. Install them and re-run this script.\n' >&2
fi
printf '\nwrote %s\n' "$OUT" >&2
