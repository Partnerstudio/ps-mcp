#!/bin/sh
# Resolve every binary the manifest needs, once, in YOUR shell, and record the
# absolute results in etc/binaries.conf.
#
# This is the only place a PATH lookup happens. It runs at install time, under a
# human, with the operator's own PATH -- never at tool-call time with input from
# a model. Everything downstream uses the absolute paths recorded here, so the
# manifest never has to guess where a tool might be installed.
set -eu

APP_DIR=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
OUT="$APP_DIR/etc/binaries.conf"
NEEDED=${*:-"node ffprobe ffmpeg gws"}

printf '# Generated by bin/ps-mcp-resolve on %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$OUT"
printf '# name=absolute path, plus prefix=... lines the sandbox grants. Do not edit;\n' >> "$OUT"
printf '# re-run bin/ps-mcp-resolve after installing or upgrading a tool.\n' >> "$OUT"

missing=''
prefixes=''
for name in $NEEDED; do
  path=$(command -v "$name" 2>/dev/null || true)
  if [ -z "$path" ] || [ ! -x "$path" ]; then
    missing="$missing $name"
    printf '  %-10s NOT FOUND on PATH\n' "$name" >&2
    continue
  fi
  # Follow symlinks: /usr/local/bin/gws is commonly a link into a version-specific
  # install, and the sandbox has to grant the real location, not the link.
  real=$(readlink -f -- "$path" 2>/dev/null || echo "$path")
  printf '%s=%s\n' "$name" "$real" >> "$OUT"
  printf '  %-10s %s\n' "$name" "$real" >&2

  dir=$(dirname -- "$real")
  case "$dir" in
    */bin) prefix=$(cd -- "$dir/.." && pwd -P) ;;
    *)     prefix=$dir ;;
  esac
  case " $prefixes " in *" $prefix "*) ;; *) prefixes="$prefixes $prefix" ;; esac
done

for p in $prefixes; do printf 'prefix=%s\n' "$p" >> "$OUT"; done

if [ -n "$missing" ]; then
  printf '\nps-mcp: not found:%s\n' "$missing" >&2
  printf 'Tools needing them will be skipped. Install them and re-run this script.\n' >&2
fi
printf '\nwrote %s\n' "$OUT" >&2
